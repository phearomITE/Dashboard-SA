# Copy to .env.server on the server. Never commit the real values.
DB_NAME=alert_message
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-password
CLOUDFLARE_TUNNEL_TOKEN=replace-with-remote-tunnel-token
BACKUP_RETENTION_DAYS=14
# Optional OpenTelemetry collector, for example http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
